{
  "id": "epm-env-docker",
  "name": "Product Management — Docker",
  "values": [
    {
      "key": "base_url",
      "value": "http://localhost:5001",
      "type": "default",
      "enabled": true,
      "description": "API port exposed by docker-compose (API_PORT=5001)"
    },
    {
      "key": "api_version",
      "value": "v1",
      "type": "default",
      "enabled": true
    },
    {
      "key": "product_id",
      "value": "00000000-0000-0000-0000-000000000000",
      "type": "default",
      "enabled": true,
      "description": "Set automatically after Create Product runs"
    },
    {
      "key": "category_id",
      "value": "11111111-0001-0000-0000-000000000000",
      "type": "default",
      "enabled": true,
      "description": "Set to a valid category GUID before running Create/Update Product"
    },
    {
      "key": "etag",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Set automatically from Get Product By ID response ETag header"
    }
  ],
  "_postman_variable_scope": "environment"
}
