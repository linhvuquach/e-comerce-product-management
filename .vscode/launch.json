{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: Launch (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/ProductManagement.API/bin/Debug/net10.0/ProductManagement.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/ProductManagement.API",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7001;http://localhost:5001"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "API: Attach to process",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "Tests: Domain",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/tests/ProductManagement.Domain.Tests/bin/Debug/net10.0/ProductManagement.Domain.Tests.dll",
      "args": [],
      "cwd": "${workspaceFolder}/tests/ProductManagement.Domain.Tests",
      "stopAtEntry": false,
      "env": { "ASPNETCORE_ENVIRONMENT": "Test" }
    },
    {
      "name": "Tests: Application",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/tests/ProductManagement.Application.Tests/bin/Debug/net10.0/ProductManagement.Application.Tests.dll",
      "args": [],
      "cwd": "${workspaceFolder}/tests/ProductManagement.Application.Tests",
      "stopAtEntry": false,
      "env": { "ASPNETCORE_ENVIRONMENT": "Test" }
    },
    {
      "name": "Tests: Integration",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/tests/ProductManagement.Integration.Tests/bin/Debug/net10.0/ProductManagement.Integration.Tests.dll",
      "args": [],
      "cwd": "${workspaceFolder}/tests/ProductManagement.Integration.Tests",
      "stopAtEntry": false,
      "env": { "ASPNETCORE_ENVIRONMENT": "Test" }
    }
  ],
  "compounds": [
    {
      "name": "API + Docker",
      "configurations": ["API: Launch (Debug)"],
      "preLaunchTask": "docker: up",
      "stopAll": true
    }
  ]
}
