# Local .terraform directories
**/.terraform/*

# Terraform state files (never commit these)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Terraform lock file (commit this — tracks provider versions)
# .terraform.lock.hcl  ← intentionally NOT ignored

# Plan files
tfplan
*.tfplan
